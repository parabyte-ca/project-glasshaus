# Project Glasshaus configuration. ./setup.sh copies this to .env and fills in secrets.
# Never commit .env.

# --- Release / images -------------------------------------------------------
GLASSHAUS_VERSION=0.10.0
GLASSHAUS_REGISTRY=ghcr.io/parabyte-ca
GLASSHAUS_BUILD_SHA=dev

# --- Network ---------------------------------------------------------------
# Host ports (defaults chosen to avoid common homelab collisions). The web port serves the app and
# proxies /api; the MCP port is for AI assistants.
GLASSHAUS_BIND_ADDRESS=0.0.0.0
# The direct API port is for this host only by default; API clients use http://host:8470/api.
# Set 0.0.0.0 to expose it (clients then appear with their own address; forwarded headers are ignored).
GLASSHAUS_API_BIND_ADDRESS=127.0.0.1
GLASSHAUS_WEB_PORT=8470
GLASSHAUS_API_PORT=8471
GLASSHAUS_MCP_PORT=8472
# Behind another reverse proxy (Traefik, Caddy, a load balancer): its address or CIDR, so client
# addresses in the audit log and rate limits are the real ones. Leave as is otherwise.
GLASSHAUS_UPSTREAM_PROXY=127.0.0.1/32
# Proxies the API believes X-Forwarded-For from (hostnames, IPs or CIDRs). The default trusts the web
# container only.
GLASSHAUS_TRUSTED_PROXIES=web,127.0.0.1,::1
# Externally reachable URL of the web UI (used for links, CORS, OAuth redirects).
GLASSHAUS_PUBLIC_URL=http://localhost:8470
# Comma-separated extra origins allowed by CORS (web UI is same-origin, so usually empty).
GLASSHAUS_CORS_ORIGINS=
# Host[:port] patterns MCP clients may use to reach the MCP server (DNS-rebinding protection).
GLASSHAUS_MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,mcp:*
# URL MCP clients use to reach the MCP server (without /mcp). OAuth sign-in for assistants needs HTTPS
# here (or localhost); otherwise the MCP server accepts personal API tokens only.
GLASSHAUS_MCP_PUBLIC_URL=http://localhost:8472
# MCP tool calls allowed per user per minute (0 disables).
GLASSHAUS_MCP_RATE_LIMIT_PER_MINUTE=120
# API token for `glasshaus-mcp --transport stdio` (local use only).
GLASSHAUS_MCP_TOKEN=
# REST/SCIM requests per token, session or client address per minute (0 disables).
GLASSHAUS_API_RATE_LIMIT_PER_MINUTE=1200
# API worker processes (each with its own database pool).
GLASSHAUS_API_WORKERS=2

# --- Secrets (generated by setup.sh) ---------------------------------------
GLASSHAUS_SECRET_KEY=
# Owner role (migrations, backups).
POSTGRES_PASSWORD=
# Least-privilege role used by api/worker/mcp (row-level security enforced).
POSTGRES_APP_PASSWORD=
REDIS_PASSWORD=
# First owner account, created on first start when the organization has no users.
GLASSHAUS_ADMIN_PASSWORD=

# --- Application -----------------------------------------------------------
GLASSHAUS_ENV=production
GLASSHAUS_LOG_LEVEL=INFO
GLASSHAUS_LOG_JSON=true
GLASSHAUS_DEFAULT_TENANT_SLUG=default
GLASSHAUS_DEFAULT_TENANT_NAME=My organization
GLASSHAUS_ADMIN_EMAIL=admin@example.com
GLASSHAUS_ADMIN_NAME=Administrator
GLASSHAUS_MULTI_TENANT=false

# --- Automations -----------------------------------------------------------
# Webhooks may call private-network hosts (e.g. Home Assistant on 192.168.x.x or Tailscale 100.x).
# Loopback, link-local and cloud metadata addresses are always refused.
GLASSHAUS_WEBHOOK_ALLOW_PRIVATE=false
GLASSHAUS_WEBHOOK_TIMEOUT_SECONDS=10

# --- AI assistant (optional, off by default) --------------------------------
# none | anthropic (Claude API) | openai (any OpenAI-compatible server: Ollama, LM Studio, vLLM) | fake
# An organization admin must also turn it on (Admin > AI assistant). See docs/ai.md.
GLASSHAUS_AI_PROVIDER=none
# Blank uses the default: claude-opus-5-5 (anthropic) or llama3.1 (openai).
GLASSHAUS_AI_MODEL=
# anthropic: your Claude API key (or set ANTHROPIC_API_KEY). openai: optional bearer token.
GLASSHAUS_AI_API_KEY=
# openai: e.g. http://ollama:11434/v1, http://192.168.1.20:1234/v1 or
# https://<resource>.openai.azure.com/openai/v1 (Azure). anthropic: leave blank.
GLASSHAUS_AI_BASE_URL=
# openai: bearer (default) or api-key (Azure OpenAI keys).
GLASSHAUS_AI_AUTH_HEADER=bearer
# openai: api-version for classic Azure URLs (/openai/deployments/<name>); blank for /openai/v1.
GLASSHAUS_AI_API_VERSION=
GLASSHAUS_AI_RATE_LIMIT_PER_MINUTE=10
# Claude only: blank (model default), low, medium or high.
GLASSHAUS_AI_EFFORT=
# Claude only: re-run a declined request on Anthropic's recommended fallback model.
GLASSHAUS_AI_FALLBACKS=true

# --- Observability ---------------------------------------------------------
GLASSHAUS_METRICS_ENABLED=true
GLASSHAUS_OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# --- Backups ---------------------------------------------------------------
GLASSHAUS_BACKUP_DIR=./backups
GLASSHAUS_BACKUP_INTERVAL_HOURS=24
GLASSHAUS_BACKUP_RETENTION_DAYS=14
# Owner of backup files on the host (setup.sh sets these to the invoking user).
GLASSHAUS_BACKUP_UID=1000
GLASSHAUS_BACKUP_GID=1000
